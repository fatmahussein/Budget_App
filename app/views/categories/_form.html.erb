<%= form_with(model: category) do |form| %>

  <!-- Error Messages Section -->
  <% if category.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(category.errors.count, "error") %> prohibited this category from being saved:</h4>
      <ul>
        <% category.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Name Field -->
  <div class="mb-4">
    <%= form.label :name, class: 'form-label' %>
    <%= form.text_field :name, placeholder: 'Enter category name', class: 'form-control' %>
  </div>

  <!-- Icon Field -->
  <div class="mb-4">
    <%= form.label :icon, class: 'form-label' %>
    <%= form.select :icon, icons, {}, class: 'form-select' %>
  </div>

  <!-- Submit Button -->
  <div>
    <%= form.submit 'Save', class: 'btn btn-success' %>
  </div>

<% end %>
