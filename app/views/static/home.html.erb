<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Budget App</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
 
</head>
<body>
  <div class="d-flex flex-column align-items-center logocontainer">
    <div>
      <h1 class="logo">Budget</h1>
      <p>Welcome to Budget, a simple budgeting app.</p>
    </div>
    <div class="mt-4">
      <p>
        <%= link_to "Sign in", new_user_session_path, class: "btn btn-success" %>
        <%= link_to "Sign up", new_user_registration_path, class: "btn btn-ligth" %>
      </p>
    </div>
  </div>
</body>
</html>
